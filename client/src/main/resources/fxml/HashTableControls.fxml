<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
    alignment="TOP_LEFT" spacing="0" fillWidth="true" minWidth="0.0" prefWidth="240.0" maxWidth="Infinity"
    styleClass="module-control-panel" stylesheets="@../style/theme.css">
    <VBox spacing="7">
        <styleClass><String fx:value="control-section"/><String fx:value="control-card"/><String fx:value="structure-section"/></styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true" onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="structureLabel" styleClass="control-label"/><Region HBox.hgrow="ALWAYS"/><Label text="⌃" styleClass="section-chevron"/>
        </HBox>
        <ComboBox fx:id="structureSelector" maxWidth="Infinity" styleClass="dark-combo-box"/>
    </VBox>
    <VBox spacing="8">
        <styleClass><String fx:value="control-section"/><String fx:value="control-card"/><String fx:value="operation-section"/><String fx:value="structure-section"/></styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true" onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="operationsLabel" styleClass="control-label"/><Region HBox.hgrow="ALWAYS"/><Label text="⌃" styleClass="section-chevron"/>
        </HBox>
        <TextField fx:id="keyField" maxWidth="Infinity" styleClass="dark-textfield"/>
        <TextField fx:id="valueField" maxWidth="Infinity" styleClass="dark-textfield"/>
        <HBox spacing="6"><Button fx:id="putBtn" onAction="#handlePut" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-ran-blue"/><Button fx:id="findBtn" onAction="#handleFind" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-ran-gold"/></HBox>
        <Button fx:id="removeBtn" onAction="#handleRemove" maxWidth="Infinity" styleClass="btn-ran-red"/>
    </VBox>
</VBox>
