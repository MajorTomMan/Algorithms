<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
    alignment="TOP_LEFT" spacing="0" fillWidth="true"
    styleClass="module-control-panel">

    <VBox spacing="7">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="structure-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="typeLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
    </VBox>

    <VBox spacing="8">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="operation-section" />
            <String fx:value="structure-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="operationsLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <HBox spacing="6" styleClass="operation-row">
            <TextField fx:id="keyField" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <styleClass>
                    <String fx:value="dark-textfield" />
                    <String fx:value="operation-input" />
                </styleClass>
            </TextField>
            <TextField fx:id="valueField" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <styleClass>
                    <String fx:value="dark-textfield" />
                    <String fx:value="operation-input" />
                </styleClass>
            </TextField>
        </HBox>
        <HBox spacing="6" styleClass="operation-row">
            <Button fx:id="putBtn" onAction="#handlePut" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <styleClass>
                    <String fx:value="btn-ran-blue" />
                    <String fx:value="operation-button" />
                </styleClass>
            </Button>
            <Button fx:id="removeBtn" onAction="#handleRemove" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <styleClass>
                    <String fx:value="btn-ran-red" />
                    <String fx:value="operation-button" />
                </styleClass>
            </Button>
            <Button fx:id="findBtn" onAction="#handleFind" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <styleClass>
                    <String fx:value="btn-ran-gold" />
                    <String fx:value="operation-button" />
                </styleClass>
            </Button>
        </HBox>
    </VBox>
</VBox>
