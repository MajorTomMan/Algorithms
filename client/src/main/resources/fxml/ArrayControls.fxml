<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
    alignment="TOP_LEFT" spacing="0" fillWidth="true" minWidth="0.0" prefWidth="240.0" maxWidth="Infinity"
    styleClass="module-control-panel" stylesheets="@../style/theme.css">
    <VBox spacing="7">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="structure-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="structureLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <ComboBox fx:id="structureSelector" maxWidth="Infinity" />
    </VBox>

    <VBox spacing="7">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="algorithm-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="algorithmLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <ComboBox fx:id="algorithmSelector" maxWidth="Infinity" />
    </VBox>

    <VBox spacing="8">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="operation-section" />
            <String fx:value="structure-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="inputSectionLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <HBox styleClass="operation-caption-row" alignment="CENTER_LEFT">
            <Label fx:id="sizeLabel" styleClass="operation-label" />
            <Label fx:id="sizeValueLabel" styleClass="operation-value" />
        </HBox>
        <Slider fx:id="sizeSlider" min="5" max="100" value="20" blockIncrement="1"
            majorTickUnit="25" showTickLabels="true" showTickMarks="true" maxWidth="Infinity"
            styleClass="operation-slider" />
        <Button fx:id="generateBtn" onAction="#handleGenerate" maxWidth="Infinity">
            <styleClass>
                <String fx:value="btn-ran-blue" />
                <String fx:value="operation-button" />
            </styleClass>
        </Button>
    </VBox>

    <VBox spacing="8">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="operation-section" />
            <String fx:value="structure-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="operationsSectionLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <HBox spacing="6" styleClass="operation-row">
            <TextField fx:id="elementValueField" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <styleClass><String fx:value="dark-textfield" /><String fx:value="operation-input" /></styleClass>
            </TextField>
            <TextField fx:id="elementIndexField" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <styleClass><String fx:value="dark-textfield" /><String fx:value="operation-input" /></styleClass>
            </TextField>
        </HBox>
        <HBox spacing="6" styleClass="operation-row">
            <Button fx:id="addElementBtn" onAction="#handleAddElement">
                <styleClass><String fx:value="btn-ran-blue" /><String fx:value="operation-button" /></styleClass>
            </Button>
            <Button fx:id="deleteElementBtn" onAction="#handleDeleteElement">
                <styleClass><String fx:value="btn-ran-red" /><String fx:value="operation-button" /></styleClass>
            </Button>
            <Button fx:id="findElementBtn" onAction="#handleFindElement">
                <styleClass><String fx:value="btn-ran-gold" /><String fx:value="operation-button" /></styleClass>
            </Button>
        </HBox>
        <HBox spacing="6" styleClass="operation-row">
            <TextField fx:id="updateIndexField" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <styleClass><String fx:value="dark-textfield" /><String fx:value="operation-input" /></styleClass>
            </TextField>
            <TextField fx:id="updateValueField" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <styleClass><String fx:value="dark-textfield" /><String fx:value="operation-input" /></styleClass>
            </TextField>
            <Button fx:id="updateElementBtn" onAction="#handleUpdateElement">
                <styleClass><String fx:value="btn-ran-blue" /><String fx:value="operation-button" /></styleClass>
            </Button>
        </HBox>
    </VBox>

    <VBox spacing="8">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="execution-section" />
            <String fx:value="algorithm-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="executionSectionLabel">
                <styleClass>
                    <String fx:value="control-label" />
                    <String fx:value="control-section-title" />
                </styleClass>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <Button fx:id="sortBtn" onAction="#handleSort" maxWidth="Infinity">
            <styleClass>
                <String fx:value="btn-run-neon" />
                <String fx:value="operation-button" />
            </styleClass>
        </Button>
    </VBox>
</VBox>
