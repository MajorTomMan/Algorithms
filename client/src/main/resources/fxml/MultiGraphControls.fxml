<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      alignment="TOP_LEFT" spacing="12" fillWidth="true"
      styleClass="module-control-panel">
  <VBox spacing="8" styleClass="control-section,control-card,structure-section">
    <Label text="MultiGraph" styleClass="control-label"/>
    <ComboBox fx:id="directionSelector" maxWidth="Infinity"/>
    <Label text="Algorithms / 算法" styleClass="control-label"/>
    <ComboBox fx:id="algorithmSelector" maxWidth="Infinity"/>
    <Button fx:id="sampleButton" maxWidth="Infinity"
            styleClass="btn-ran-blue,operation-button" text="Load sample / 加载示例"/>
    <Label text="Use loadBatch(data) to load an annotated batch object."
           wrapText="true"/>
  </VBox>
  <VBox spacing="8" styleClass="control-section,control-card,structure-section">
    <Label text="Selected node / edge" styleClass="control-label"/>
    <Label fx:id="selectionInfo" wrapText="true" maxWidth="Infinity"/>
  </VBox>
</VBox>
