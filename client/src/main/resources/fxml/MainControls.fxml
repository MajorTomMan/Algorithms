<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import java.lang.String?>
<?import java.lang.Double?>
<?import com.majortom.algorithms.visualization.logging.LogView?>
<?import com.majortom.algorithms.visualization.common.OverlayPane?>
<?import com.majortom.algorithms.visualization.layout.PlaybackToolbar?>
<?import com.majortom.algorithms.visualization.navigation.FamilyNavigator?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.majortom.algorithms.visualization.impl.controller.MainController"
    styleClass="root-pane" stylesheets="@../style/theme.css">

    <top>
        <VBox fx:id="topShell" styleClass="top-shell">
            <HBox fx:id="topBar"
                styleClass="lab-top-bar" alignment="CENTER_LEFT">
                <HBox fx:id="brandZone" alignment="CENTER_LEFT"
                    styleClass="brand-zone">
                    <StackPane styleClass="brand-mark">
                        <Polygon styleClass="brand-mark-red">
                            <points>
                                <Double fx:value="0" />
                                <Double fx:value="0" />
                                <Double fx:value="46" />
                                <Double fx:value="0" />
                                <Double fx:value="0" />
                                <Double fx:value="46" />
                            </points>
                        </Polygon>
                        <Polygon styleClass="brand-mark-white">
                            <points>
                                <Double fx:value="46" />
                                <Double fx:value="46" />
                                <Double fx:value="12" />
                                <Double fx:value="46" />
                                <Double fx:value="46" />
                                <Double fx:value="12" />
                            </points>
                        </Polygon>
                    </StackPane>
                    <VBox spacing="1" alignment="CENTER_LEFT">
                        <Label text="ALGORITHMS / LAB" styleClass="brand-title-main" />
                        <Label fx:id="brandSubtitle" text="EXPLORE · VISUALIZE · UNDERSTAND"
                            styleClass="brand-subtitle" />
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox fx:id="workspaceModeBox"
                    styleClass="lab-mode-switch" alignment="CENTER" spacing="0">
                    <Button fx:id="structureWorkspaceBtn" text="STRUCTURE"
                        onAction="#selectStructureWorkspace"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <styleClass>
                            <String fx:value="workspace-mode-button" />
                            <String fx:value="workspace-mode-first" />
                        </styleClass>
                    </Button>
                    <Button fx:id="algorithmWorkspaceBtn" text="ALGORITHM"
                        onAction="#selectAlgorithmWorkspace"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <styleClass>
                            <String fx:value="workspace-mode-button" />
                            <String fx:value="workspace-mode-middle" />
                        </styleClass>
                    </Button>
                    <Button fx:id="practiceWorkspaceBtn" text="PRACTICE"
                        onAction="#selectPracticeWorkspace"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <styleClass>
                            <String fx:value="workspace-mode-button" />
                            <String fx:value="workspace-mode-last" />
                        </styleClass>
                    </Button>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox fx:id="topContextZone"
                    alignment="CENTER_RIGHT" styleClass="top-context-zone">
                    <Label fx:id="topContextLabel" text="ARRAY / STRUCTURE EDITOR"
                        styleClass="top-context-title" />
                    <Label fx:id="runStateLabel" text="EDITING" styleClass="run-state-badge" />
                    <Label fx:id="runIdLabel" text="" styleClass="run-id-label" />
                    <Separator orientation="VERTICAL" styleClass="font-settings-divider" />
                    <Button fx:id="fontSettingsBtn" text="Aa" onAction="#toggleFontSettings"
                        styleClass="font-settings-button" />
                </HBox>
                <Label fx:id="menuTitleLabel" managed="false" visible="false" />
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox fx:id="workbenchShell" styleClass="workbench-shell">
            <FamilyNavigator fx:id="familyNavigator" HBox.hgrow="NEVER" />
            <StackPane fx:id="workspaceLayer" HBox.hgrow="ALWAYS" styleClass="workspace-layer">
            <!-- ========================== STRUCTURE MODE ========================== -->
            <VBox fx:id="structureWorkspacePane" focusTraversable="true" styleClass="lab-workspace">
                <HBox fx:id="structureWorkspaceBody" VBox.vgrow="ALWAYS"
                    styleClass="lab-workspace-body">
                    <VBox fx:id="structureControlRail" styleClass="structure-control-panel">
                        <HBox alignment="CENTER_LEFT" styleClass="panel-topline">
                            <Label fx:id="structureWorkspaceTitleLabel" text="STRUCTURE"
                                styleClass="panel-eyebrow" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="⚙" styleClass="panel-gear" />
                        </HBox>
                        <VBox spacing="2" styleClass="structure-identity-block">
                            <Label fx:id="structureWorkspaceSubtitleLabel" text="TREE"
                                styleClass="structure-identity-title" />
                            <Label fx:id="structureControlsTitleLabel" text="LIVE STRUCTURE"
                                styleClass="structure-identity-meta" />
                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="live-row">
                                <Region styleClass="live-dot" />
                                <Label fx:id="structureLiveLabel" text="LIVE STRUCTURE"
                                    styleClass="live-label" />
                            </HBox>
                        </VBox>
                        <Separator />
                        <ScrollPane fx:id="structureControlsScroll" fitToWidth="true"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS" styleClass="panel-scroll-pane light-scroll-pane">
                            <content>
                                <VBox fillWidth="true" spacing="0" styleClass="module-control-host">
                                    <VBox fx:id="structureKindHost" fillWidth="true" />
                                    <VBox fx:id="valueTypeBox" spacing="8" styleClass="control-section">
                                        <Label fx:id="valueTypeLabel" styleClass="panel-section-title" />
                                        <ComboBox fx:id="valueTypeSelector" maxWidth="Infinity" />
                                        <Label fx:id="hashValueTypeLabel" managed="false" visible="false" />
                                        <ComboBox fx:id="hashValueTypeSelector" managed="false" visible="false" />
                                    </VBox>
                                    <VBox fx:id="structureControlsHost" fillWidth="true" spacing="0">
                                        <HBox fx:id="customControlBox" maxWidth="Infinity"
                                            fillHeight="true" />
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                        <VBox spacing="8" styleClass="snapshot-quick-block">
                            <Separator />
                            <Label fx:id="snapshotQuickTitleLabel" text="SNAPSHOT"
                                styleClass="panel-section-title" />
                            <Button fx:id="saveSnapshotBtn" text="SAVE SNAPSHOT"
                                onAction="#saveStructureSnapshot" maxWidth="Infinity"
                                styleClass="primary-red-button" />
                            <HBox spacing="0" styleClass="summary-strip">
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label fx:id="structurePrimaryMetricTitleLabel" text="NODES"
                                        styleClass="summary-caption" />
                                    <Label fx:id="structureNodeCountLabel" text="—"
                                        styleClass="summary-number-red" />
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label fx:id="structureSecondaryMetricTitleLabel" text="HEIGHT"
                                        styleClass="summary-caption" />
                                    <Label fx:id="structureHeightLabel" text="—"
                                        styleClass="summary-number" />
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label fx:id="structureStateMetricTitleLabel" text="STATE"
                                        styleClass="summary-caption" />
                                    <Label fx:id="structureStateLabel" text="READY"
                                        styleClass="summary-number-blue" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <StackPane fx:id="structurePreviewViewport" HBox.hgrow="ALWAYS"
                        styleClass="lab-canvas">
                        <HBox fx:id="structureSnapshotPreviewBadge" managed="false" visible="false"
                            mouseTransparent="true"
                            alignment="CENTER_LEFT" spacing="8" StackPane.alignment="TOP_LEFT"
                            styleClass="snapshot-preview-badge">
                            <Label fx:id="structureSnapshotPreviewBadgeLabel"
                                text="SNAPSHOT PREVIEW · READ ONLY"
                                styleClass="snapshot-preview-badge-title" />
                            <Label fx:id="structureSnapshotPreviewIdLabel"
                                styleClass="snapshot-preview-badge-id" />
                        </HBox>
                        <VBox fx:id="structurePreviewEmpty" alignment="CENTER" spacing="10"
                            mouseTransparent="true" styleClass="structure-preview-empty">
                            <Label fx:id="structurePreviewTitleLabel"
                                styleClass="structure-preview-title" />
                            <Label fx:id="structurePreviewHintLabel" wrapText="true" styleClass="structure-preview-hint" />
                        </VBox>
                        <OverlayPane mouseTransparent="true">
                        <VBox fx:id="structureSelectionOverlay" mouseTransparent="true"
                            managed="false" visible="false"
                            StackPane.alignment="TOP_RIGHT" styleClass="selection-overlay">
                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="selectedEntityTitleLabel" text="SELECTED NODE"
                                    styleClass="overlay-eyebrow" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="selectedNodeIdLabel" text="#—" styleClass="overlay-id" />
                            </HBox>
                            <Label fx:id="selectedValueCaptionLabel" text="VALUE"
                                styleClass="overlay-caption" />
                            <Label fx:id="selectedNodeValueLabel" text="—" minWidth="0" maxWidth="Infinity" textOverrun="ELLIPSIS"
                                styleClass="overlay-value" />
                            <Separator />
                            <Label fx:id="selectedEntityHintLabel"
                                text="Ready to edit or remove this node." wrapText="true"
                                styleClass="overlay-hint" />
                        </VBox>
                        </OverlayPane>
                    </StackPane>

                    <VBox fx:id="snapshotPanel"
                        styleClass="inspector-panel">
                        <VBox fx:id="snapshotPreviewNotice" managed="false" visible="false"
                            spacing="7" styleClass="snapshot-preview-notice">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label fx:id="snapshotPreviewNoticeTitleLabel"
                                    text="SNAPSHOT PREVIEW · READ ONLY"
                                    styleClass="snapshot-preview-notice-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="snapshotPreviewNoticeIdLabel"
                                    styleClass="snapshot-preview-notice-id" />
                            </HBox>
                            <Label fx:id="snapshotPreviewNoticeHintLabel"
                                text="This is a frozen snapshot. Restore it to the live structure before editing."
                                wrapText="true" styleClass="snapshot-preview-notice-hint" />
                            <Button fx:id="snapshotPreviewRestoreBtn" text="RESTORE STRUCTURE"
                                onAction="#restoreSelectedPreviewSnapshot" maxWidth="Infinity"
                                styleClass="snapshot-preview-restore-button" />
                        </VBox>
                        <TabPane fx:id="structureInspectorTabs" tabClosingPolicy="UNAVAILABLE"
                            VBox.vgrow="ALWAYS" styleClass="inspector-tabs">
                            <tabs>
                                <Tab fx:id="structureInspectorTab" text="INSPECTOR">
                                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                        styleClass="light-scroll-pane">
                                        <content>
                                            <VBox spacing="0" styleClass="inspector-content">
                                                <VBox spacing="10" styleClass="inspector-section">
                                                    <Label fx:id="currentSelectionHeadingLabel"
                                                        text="CURRENT SELECTION"
                                                        styleClass="inspector-heading" />
                                                    <Label fx:id="structureInspectorBody"
                                                        text="Select an element in the canvas."
                                                        wrapText="true" styleClass="inspector-body" />
                                                </VBox>
                                                <VBox spacing="10" styleClass="inspector-section">
                                                    <Label fx:id="structureOverviewHeadingLabel"
                                                        text="STRUCTURE OVERVIEW"
                                                        styleClass="inspector-heading" />
                                                    <GridPane hgap="0" vgap="0"
                                                        styleClass="structure-overview-grid">
                                                        <columnConstraints>
                                                            <ColumnConstraints percentWidth="25"
                                                                halignment="CENTER" />
                                                            <ColumnConstraints percentWidth="25"
                                                                halignment="CENTER" />
                                                            <ColumnConstraints percentWidth="25"
                                                                halignment="CENTER" />
                                                            <ColumnConstraints percentWidth="25"
                                                                halignment="CENTER" />
                                                        </columnConstraints>
                                                        <VBox alignment="CENTER" spacing="3"
                                                            GridPane.columnIndex="0"
                                                            styleClass="overview-tile">
                                                            <Label fx:id="overviewPrimaryTitleLabel"
                                                                text="NODES"
                                                                styleClass="metric-title" />
                                                            <Label fx:id="overviewPrimaryValue"
                                                                text="—"
                                                                styleClass="overview-value-blue" />
                                                        </VBox>
                                                        <VBox alignment="CENTER" spacing="3"
                                                            GridPane.columnIndex="1"
                                                            styleClass="overview-tile">
                                                            <Label
                                                                fx:id="overviewSecondaryTitleLabel"
                                                                text="HEIGHT"
                                                                styleClass="metric-title" />
                                                            <Label fx:id="overviewSecondaryValue"
                                                                text="—" styleClass="overview-value" />
                                                        </VBox>
                                                        <VBox alignment="CENTER" spacing="3"
                                                            GridPane.columnIndex="2"
                                                            styleClass="overview-tile">
                                                            <Label fx:id="overviewEventsTitleLabel"
                                                                text="EVENTS"
                                                                styleClass="metric-title" />
                                                            <Label fx:id="overviewEventsValue"
                                                                text="0"
                                                                styleClass="overview-value-yellow" />
                                                        </VBox>
                                                        <VBox alignment="CENTER" spacing="3"
                                                            GridPane.columnIndex="3"
                                                            styleClass="overview-tile">
                                                            <Label fx:id="overviewStateTitleLabel"
                                                                text="STATE"
                                                                styleClass="metric-title" />
                                                            <Label fx:id="overviewStateValue"
                                                                text="READY"
                                                                styleClass="overview-value" />
                                                        </VBox>
                                                    </GridPane>
                                                    <Label fx:id="structureOverviewLabel"
                                                        text="Ready" managed="false" visible="false" />
                                                </VBox>
                                                <VBox spacing="8"
                                                    styleClass="inspector-section inspector-snapshot-section">
                                                    <Label fx:id="inspectorSnapshotsHeadingLabel"
                                                        text="SNAPSHOTS"
                                                        styleClass="inspector-heading" />
                                                    <VBox fx:id="inspectorSnapshotCards" spacing="8"
                                                        fillWidth="true" />
                                                </VBox>
                                            </VBox>
                                        </content>
                                    </ScrollPane>
                                </Tab>
                                <Tab fx:id="structureSnapshotsTab" text="SNAPSHOTS">
                                    <VBox spacing="8" styleClass="snapshot-tab-content">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label fx:id="snapshotTitleLabel" text="SNAPSHOTS"
                                                styleClass="inspector-heading" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="snapshotCountLabel"
                                                styleClass="snapshot-count" />
                                        </HBox>
                                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                            vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                                            styleClass="light-scroll-pane">
                                            <content>
                                                <VBox fx:id="snapshotCards" fillWidth="true"
                                                    spacing="8" />
                                            </content>
                                        </ScrollPane>
                                    </VBox>
                                </Tab>
                            </tabs>
                        </TabPane>
                    </VBox>
                </HBox>

                <VBox fx:id="structureHistoryDock" styleClass="history-dock">
                    <HBox alignment="CENTER_LEFT" styleClass="history-header">
                        <Label fx:id="structureHistoryTitleLabel" text="STRUCTURE HISTORY"
                            styleClass="history-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="structureHistoryCountLabel" styleClass="history-count" />
                        <Button fx:id="structureHistoryToggleBtn" text="▲"
                            onAction="#toggleStructureHistory" styleClass="history-toggle" />
                    </HBox>
                    <ScrollPane fx:id="structureHistoryDetails" managed="false" visible="false"
                        fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS" styleClass="history-scroll">
                        <content>
                            <HBox fx:id="structureHistoryCards" spacing="28" alignment="CENTER_LEFT"
                                styleClass="history-cards" />
                        </content>
                    </ScrollPane>
                </VBox>
            </VBox>

            <!-- ========================== ALGORITHM MODE ========================== -->
            <VBox fx:id="algorithmWorkspacePane" focusTraversable="true" managed="false"
                visible="false" styleClass="lab-workspace">
                <HBox fx:id="algorithmWorkspaceBody" VBox.vgrow="ALWAYS"
                    styleClass="lab-workspace-body">
                    <VBox fx:id="algorithmControlRail" styleClass="algorithm-control-panel">
                        <HBox alignment="CENTER_LEFT" styleClass="panel-topline">
                            <Label fx:id="algorithmWorkspaceTitleLabel" text="ALGORITHM"
                                styleClass="panel-eyebrow" />
                        </HBox>
                        <VBox spacing="2" styleClass="structure-identity-block">
                            <Label fx:id="algorithmWorkspaceSubtitleLabel" text="ALGORITHM"
                                styleClass="structure-identity-title" />
                            <Label fx:id="algorithmControlsTitleLabel" text="TREE / 05"
                                styleClass="structure-identity-meta" />
                        </VBox>
                        <Separator />
                        <VBox spacing="8" styleClass="input-source-block">
                            <Label fx:id="algorithmInputTitleLabel" text="INPUT SOURCE"
                                styleClass="panel-section-title" />
                            <HBox spacing="6" styleClass="input-source-toggle-row">
                                <Button fx:id="currentInputBtn" text="● CURRENT STRUCTURE"
                                    onAction="#useCurrentStructureInput" HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity" styleClass="input-source-toggle" />
                                <Button fx:id="savedInputBtn" text="○ SAVED SNAPSHOT"
                                    onAction="#useLatestSnapshotInput" HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity" styleClass="input-source-toggle" />
                            </HBox>
                            <Label fx:id="algorithmInputSourceLabel" text="Current Structure"
                                wrapText="true" styleClass="algorithm-input-source-card" />
                        </VBox>
                        <ScrollPane fx:id="algorithmControlsScroll" fitToWidth="true"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                            styleClass="panel-scroll-pane light-scroll-pane">
                            <content>
                                <VBox fillWidth="true" spacing="0" styleClass="module-control-host">
                                    <VBox fx:id="algorithmControlsHost" fillWidth="true" spacing="0" />
                                </VBox>
                            </content>
                        </ScrollPane>
                        <Button fx:id="startBtn" text="RUN ALGORITHM" maxWidth="Infinity"
                            styleClass="primary-red-button" />
                    </VBox>

                    <StackPane fx:id="visualizationViewport" HBox.hgrow="ALWAYS" styleClass="lab-canvas">
                        <StackPane fx:id="visualizationContainer"
                            styleClass="visualization-container" />
                        <VBox fx:id="currentStepOverlay" mouseTransparent="true" managed="false"
                            visible="false"
                            StackPane.alignment="TOP_LEFT" styleClass="current-step-overlay">
                            <Label fx:id="algorithmViewTitleLabel" text="CURRENT STEP"
                                styleClass="overlay-eyebrow" />
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label fx:id="currentStepSequenceLabel" text="#0000"
                                    styleClass="current-step-sequence" />
                                <Label fx:id="currentStepKindLabel" text="EVENT"
                                    styleClass="current-step-kind" />
                            </HBox>
                            <Label fx:id="currentStepDetailLabel" text="" wrapText="true"
                                styleClass="current-step-detail" />
                            <Label fx:id="viewportHintLabel" managed="false" visible="false" />
                        </VBox>
                        <OverlayPane mouseTransparent="true">
                        <VBox fx:id="algorithmSelectionOverlay" mouseTransparent="true"
                            managed="false" visible="false"
                            StackPane.alignment="TOP_RIGHT" styleClass="selection-overlay">
                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="algorithmSelectedEntityTitleLabel"
                                    text="SELECTED ITEM" styleClass="overlay-eyebrow" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="algorithmSelectedNodeIdLabel" text="#—"
                                    styleClass="overlay-id" />
                            </HBox>
                            <Label fx:id="algorithmSelectedValueCaptionLabel" text="VALUE"
                                styleClass="overlay-caption" />
                            <Label fx:id="algorithmSelectedNodeValueLabel" text="—" minWidth="0" maxWidth="Infinity" textOverrun="ELLIPSIS"
                                styleClass="overlay-value" />
                            <Separator />
                            <Label fx:id="algorithmSelectedEntityHintLabel"
                                text="Current algorithm frame · read only" wrapText="true"
                                styleClass="overlay-hint" />
                        </VBox>
                        </OverlayPane>
                    </StackPane>

                    <VBox fx:id="diagnosticsPanel" styleClass="inspector-panel">
                        <TabPane fx:id="algorithmInspectorTabs" tabClosingPolicy="UNAVAILABLE"
                            VBox.vgrow="ALWAYS" styleClass="inspector-tabs algorithm-tabs">
                            <tabs>
                                <Tab fx:id="statisticsTab" text="STATISTICS">
                                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                        styleClass="light-scroll-pane">
                                        <content>
                                            <VBox spacing="12" styleClass="inspector-content">
                                                <HBox alignment="CENTER_LEFT">
                                                    <Label fx:id="statsTitleLabel"
                                                        text="RUN SUMMARY"
                                                        styleClass="inspector-heading" />
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <Label fx:id="liveLabel" text="LIVE"
                                                        styleClass="status-mini" />
                                                </HBox>
                                                <Label fx:id="statsLabel" wrapText="true"
                                                    maxWidth="Infinity"
                                                    styleClass="stats-text-light" />
                                            </VBox>
                                        </content>
                                    </ScrollPane>
                                </Tab>
                                <Tab fx:id="eventTab" text="EVENT">
                                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                        styleClass="light-scroll-pane">
                                        <content>
                                            <VBox spacing="12"
                                                styleClass="inspector-content event-inspector-content">
                                                <VBox spacing="9" styleClass="event-card">
                                                    <Label fx:id="currentEventHeadingLabel"
                                                        text="CURRENT EVENT"
                                                        styleClass="inspector-heading" />
                                                    <HBox alignment="CENTER_LEFT" spacing="9">
                                                        <Region fx:id="eventKindDot"
                                                            styleClass="event-kind-dot" />
                                                        <Label fx:id="eventKindLabel"
                                                            text="NO EVENT" styleClass="event-kind" />
                                                    </HBox>
                                                    <Separator />
                                                    <Label fx:id="eventDetailsLabel"
                                                        text="Run an algorithm or select a timeline event."
                                                        wrapText="true"
                                                        styleClass="inspector-body event-detail-body" />
                                                </VBox>
                                                <VBox spacing="8" styleClass="event-card">
                                                    <Label fx:id="eventRunSummaryHeadingLabel"
                                                        text="RUN SUMMARY"
                                                        styleClass="inspector-heading" />
                                                    <GridPane hgap="0" vgap="0"
                                                        styleClass="run-summary-grid">
                                                        <columnConstraints>
                                                            <ColumnConstraints percentWidth="50"
                                                                halignment="CENTER" />
                                                            <ColumnConstraints percentWidth="50"
                                                                halignment="CENTER" />
                                                        </columnConstraints>
                                                        <rowConstraints>
                                                            <RowConstraints percentHeight="50"
                                                                valignment="CENTER" />
                                                            <RowConstraints percentHeight="50"
                                                                valignment="CENTER" />
                                                        </rowConstraints>
                                                        <VBox alignment="CENTER" spacing="3"
                                                            GridPane.columnIndex="0"
                                                            GridPane.rowIndex="0"
                                                            styleClass="metric-tile">
                                                            <Label fx:id="runMetric1Title"
                                                                text="EVENTS"
                                                                styleClass="metric-title" />
                                                            <Label fx:id="runMetric1Value" text="0"
                                                                styleClass="metric-value" />
                                                        </VBox>
                                                        <VBox alignment="CENTER" spacing="3"
                                                            GridPane.columnIndex="1"
                                                            GridPane.rowIndex="0"
                                                            styleClass="metric-tile">
                                                            <Label fx:id="runMetric2Title"
                                                                text="DOMAIN"
                                                                styleClass="metric-title" />
                                                            <Label fx:id="runMetric2Value" text="0"
                                                                styleClass="metric-value" />
                                                        </VBox>
                                                        <VBox alignment="CENTER" spacing="3"
                                                            GridPane.columnIndex="0"
                                                            GridPane.rowIndex="1"
                                                            styleClass="metric-tile">
                                                            <Label fx:id="runMetric3Title"
                                                                text="OBSERVED"
                                                                styleClass="metric-title" />
                                                            <Label fx:id="runMetric3Value" text="0"
                                                                styleClass="metric-value" />
                                                        </VBox>
                                                        <VBox alignment="CENTER" spacing="3"
                                                            GridPane.columnIndex="1"
                                                            GridPane.rowIndex="1"
                                                            styleClass="metric-tile">
                                                            <Label fx:id="runMetric4Title"
                                                                text="DURATION"
                                                                styleClass="metric-title" />
                                                            <Label fx:id="runMetric4Value"
                                                                text="00:00:00"
                                                                styleClass="metric-value" />
                                                        </VBox>
                                                    </GridPane>
                                                </VBox>
                                                <VBox spacing="8" styleClass="event-card">
                                                    <Label fx:id="resultPreviewHeadingLabel"
                                                        text="RESULT PREVIEW"
                                                        styleClass="inspector-heading" />
                                                    <Label fx:id="resultPreviewLabel"
                                                        text="No result yet." wrapText="true"
                                                        maxWidth="Infinity"
                                                        styleClass="result-preview-value" />
                                                </VBox>
                                            </VBox>
                                        </content>
                                    </ScrollPane>
                                </Tab>
                                <Tab fx:id="logTab" text="LOG">
                                    <VBox spacing="8" styleClass="snapshot-tab-content">
                                        <Label fx:id="logTitleLabel" text="LOG"
                                            styleClass="inspector-heading" />
                                        <LogView fx:id="logView" VBox.vgrow="ALWAYS"
                                            styleClass="log-view-light" />
                                    </VBox>
                                </Tab>
                                <Tab fx:id="resultTab" text="RESULT">
                                    <VBox spacing="12" styleClass="inspector-content">
                                        <Label fx:id="resultHeadingLabel" text="RESULT"
                                            styleClass="inspector-heading" />
                                        <Label fx:id="resultLabel" text="No result yet."
                                            wrapText="true" styleClass="result-value" />
                                    </VBox>
                                </Tab>
                            </tabs>
                        </TabPane>
                    </VBox>
                </HBox>

                <VBox fx:id="bottomDock">
                    <styleClass>
                        <String fx:value="algorithm-dock" />
                        <String fx:value="timeline-collapsed" />
                    </styleClass>
                    <PlaybackToolbar fx:id="playbackToolbar" styleClass="timeline-compact-row">
                        <VBox alignment="CENTER_LEFT" spacing="6" styleClass="playback-leading-area">
                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="timeline-title-row">
                                <Region styleClass="timeline-title-accent" />
                                <Label fx:id="timelineLabel" text="EXECUTION TIMELINE"
                                    styleClass="timeline-toolbar-title" />
                                <Region fx:id="timelineStatusDot" styleClass="timeline-status-dot" />
                                <Label fx:id="timelineStatusLabel" text="" styleClass="timeline-status-label" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="7" styleClass="playback-control-group">
                                <Button fx:id="jumpStartBtn" text="|◀">
                                    <styleClass>
                                        <String fx:value="playback-button" />
                                        <String fx:value="playback-icon-button" />
                                    </styleClass>
                                </Button>
                                <Button fx:id="stepBackwardBtn" text="‹">
                                    <styleClass>
                                        <String fx:value="playback-button" />
                                        <String fx:value="playback-icon-button" />
                                    </styleClass>
                                </Button>
                                <Button fx:id="pauseBtn" text="❚❚">
                                    <styleClass>
                                        <String fx:value="playback-button" />
                                        <String fx:value="playback-icon-button" />
                                        <String fx:value="playback-primary" />
                                    </styleClass>
                                </Button>
                                <Button fx:id="endExecutionBtn" text="END">
                                    <styleClass>
                                        <String fx:value="playback-button" />
                                        <String fx:value="playback-text-button" />
                                        <String fx:value="playback-end-button" />
                                    </styleClass>
                                </Button>
                                <Button fx:id="closeExecutionBtn" text="CLOSE">
                                    <styleClass>
                                        <String fx:value="playback-button" />
                                        <String fx:value="playback-text-button" />
                                        <String fx:value="playback-close-button" />
                                    </styleClass>
                                </Button>
                                <Button fx:id="stepForwardBtn" text="›">
                                    <styleClass>
                                        <String fx:value="playback-button" />
                                        <String fx:value="playback-icon-button" />
                                    </styleClass>
                                </Button>
                                <Button fx:id="jumpEndBtn" text="▶|">
                                    <styleClass>
                                        <String fx:value="playback-button" />
                                        <String fx:value="playback-icon-button" />
                                    </styleClass>
                                </Button>
                            </HBox>
                        </VBox>

                        <VBox alignment="CENTER_LEFT" spacing="5" maxWidth="Infinity"
                            styleClass="playback-timeline-area">
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="timeline-current-row">
                                <Label fx:id="timelineCursorLabel" text="" visible="false" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    mouseTransparent="true" styleClass="timeline-current-summary" />
                            </HBox>
                            <StackPane maxWidth="Infinity" styleClass="timeline-compact-track">
                                <Slider fx:id="timelineSlider" min="0" max="1" value="0" disable="true"
                                    maxWidth="Infinity" StackPane.alignment="CENTER" />
                                <Pane fx:id="timelineMarkers" pickOnBounds="false" mouseTransparent="false"
                                    StackPane.alignment="CENTER">
                                    <styleClass>
                                        <String fx:value="timeline-markers" />
                                        <String fx:value="timeline-markers-compact" />
                                    </styleClass>
                                </Pane>
                            </StackPane>
                        </VBox>

                        <VBox alignment="CENTER_RIGHT" spacing="6" styleClass="playback-speed-area">
                            <Label fx:id="speedLabel" text="SPEED" styleClass="speed-label" />
                            <HBox alignment="CENTER_RIGHT" spacing="7" styleClass="speed-control-group">
                                <HBox fx:id="speedButtonBox" alignment="CENTER" spacing="0"
                                    styleClass="speed-button-group">
                                    <Button fx:id="speed1Btn" text="1×" styleClass="speed-button" />
                                    <Button fx:id="speed2Btn" text="2×" styleClass="speed-button" />
                                    <Button fx:id="speed4Btn" text="4×" styleClass="speed-button" />
                                    <Button fx:id="speed8Btn" text="8×" styleClass="speed-button" />
                                    <Button fx:id="speed16Btn" text="16×" styleClass="speed-button" />
                                </HBox>
                                <Button fx:id="timelineToggleBtn" text="▼" onAction="#toggleTimelineDetails">
                                    <styleClass>
                                        <String fx:value="timeline-toggle-button" />
                                        <String fx:value="timeline-header-toggle" />
                                    </styleClass>
                                </Button>
                            </HBox>
                        </VBox>

                        <!-- Legacy WorkbenchControls hooks remain available but are no longer part of the visible toolbar. -->
                        <Button fx:id="replayBtn" managed="false" visible="false" />
                        <Button fx:id="resetBtn" managed="false" visible="false" />
                        <Slider fx:id="delaySlider" min="0" max="500" value="50" managed="false"
                            visible="false" />
                        <Label fx:id="delayLabel" managed="false" visible="false" />
                        <Button fx:id="exportBtn" managed="false" visible="false" />
                        <Button fx:id="compareBtn" managed="false" visible="false" />
                    </PlaybackToolbar>

                    <VBox fx:id="timelineDetailPanel" managed="false" visible="false"
                        styleClass="timeline-detail-panel">
                        <FlowPane fx:id="timelineDetails" hgap="16" vgap="4" alignment="CENTER_LEFT"
                            styleClass="timeline-legend">
                            <Label fx:id="timelineRuntimeLegendLabel" text="◆ Runtime"
                                styleClass="timeline-legend-runtime" />
                            <Label fx:id="timelineStructureLegendLabel" text="■ Structure"
                                styleClass="timeline-legend-structure" />
                            <Label fx:id="timelineObservationLegendLabel" text="● Observation"
                                styleClass="timeline-legend-observation" />
                        </FlowPane>
                    </VBox>
                    <HBox fx:id="timelineRow" managed="false" visible="false" />
                </VBox>
            </VBox>


            <!-- =========================== PRACTICE MODE =========================== -->
            <VBox fx:id="practiceWorkspacePane" focusTraversable="true" managed="false" visible="false">
                <styleClass>
                    <String fx:value="lab-workspace" />
                    <String fx:value="practice-workspace" />
                </styleClass>
                <HBox VBox.vgrow="ALWAYS" styleClass="lab-workspace-body">
                    <VBox fx:id="practiceControlRail">
                        <styleClass>
                            <String fx:value="structure-control-panel" />
                            <String fx:value="practice-control-panel" />
                        </styleClass>
                        <HBox alignment="CENTER_LEFT" styleClass="panel-topline">
                            <Label fx:id="practiceWorkspaceTitleLabel" text="PRACTICE"
                                styleClass="panel-eyebrow" />
                        </HBox>
                        <VBox spacing="4" styleClass="structure-identity-block">
                            <Label fx:id="practiceCatalogTitleLabel" text="PROBLEM CATALOG"
                                styleClass="structure-identity-title" />
                            <Label fx:id="practiceCatalogHintLabel" text="Discovered @Problem components"
                                wrapText="true" styleClass="structure-identity-meta" />
                        </VBox>
                        <Separator />
                        <ListView fx:id="practiceProblemList" VBox.vgrow="ALWAYS" styleClass="practice-problem-list" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="14" HBox.hgrow="ALWAYS">
                        <styleClass>
                            <String fx:value="lab-canvas" />
                            <String fx:value="practice-detail-pane" />
                        </styleClass>
                        <Label fx:id="practiceProblemNameLabel" text="—">
                            <styleClass>
                                <String fx:value="brand-title-main" />
                                <String fx:value="practice-problem-name" />
                            </styleClass>
                        </Label>
                        <Label fx:id="practiceProblemMetaLabel" text="" wrapText="true">
                            <styleClass>
                                <String fx:value="structure-identity-meta" />
                                <String fx:value="practice-problem-meta" />
                            </styleClass>
                        </Label>
                        <Separator styleClass="practice-detail-separator" />
                        <Label fx:id="practiceProblemEntryLabel" text="" wrapText="true" maxWidth="Infinity">
                            <styleClass>
                                <String fx:value="result-value" />
                                <String fx:value="practice-problem-entry" />
                            </styleClass>
                        </Label>
                        <Label fx:id="practiceEmptyLabel" text="" wrapText="true">
                            <styleClass>
                                <String fx:value="structure-identity-meta" />
                                <String fx:value="practice-empty-state" />
                            </styleClass>
                        </Label>
                    </VBox>
                </HBox>
            </VBox>
            </StackPane>
        </HBox>
    </center>
</BorderPane>
