<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<?import com.majortom.algorithms.visualization.logging.LogView?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.majortom.algorithms.visualization.impl.controller.MainController"
    prefHeight="900.0" prefWidth="1600.0" minWidth="0.0" minHeight="0.0"
    styleClass="root-pane" stylesheets="@../style/theme.css">

    <top>
        <VBox fx:id="topShell" styleClass="top-shell">
            <HBox fx:id="topBar" minHeight="58.0" prefHeight="58.0" maxHeight="58.0"
                styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="menuTitleLabel" styleClass="brand-title" />
                <Separator orientation="VERTICAL" styleClass="top-divider" />
                <HBox fx:id="workspaceModeBox" styleClass="workspace-mode-nav" alignment="CENTER_LEFT" spacing="2">
                    <Button fx:id="structureWorkspaceBtn" onAction="#selectStructureWorkspace"
                        styleClass="workspace-mode-button" />
                    <Button fx:id="algorithmWorkspaceBtn" onAction="#selectAlgorithmWorkspace"
                        styleClass="workspace-mode-button" />
                </HBox>
                <HBox fx:id="valueTypeBox" alignment="CENTER_LEFT" spacing="6" styleClass="value-type-box">
                    <Label fx:id="valueTypeLabel" styleClass="value-type-label" />
                    <ComboBox fx:id="valueTypeSelector" prefWidth="126.0" styleClass="value-type-selector" />
                    <Label fx:id="hashValueTypeLabel" styleClass="value-type-label" />
                    <ComboBox fx:id="hashValueTypeSelector" prefWidth="126.0" styleClass="value-type-selector" />
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Separator orientation="VERTICAL" styleClass="top-divider" />
                <Button fx:id="langBtn" text="EN / 中文" onAction="#toggleLanguage"
                    styleClass="shell-toggle-button" />
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="workspaceLayer" HBox.hgrow="ALWAYS" styleClass="workspace-layer">
            <VBox fx:id="structureWorkspacePane" focusTraversable="true"
                styleClass="workspace-pane">
                <HBox styleClass="workspace-pane-header" alignment="CENTER_LEFT" spacing="8">
                    <VBox spacing="2">
                        <Label fx:id="structureWorkspaceTitleLabel" styleClass="workspace-title" />
                        <Label fx:id="structureWorkspaceSubtitleLabel" styleClass="workspace-subtitle" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="01">
                        <styleClass>
                            <String fx:value="workspace-index" />
                            <String fx:value="workspace-index-blue" />
                        </styleClass>
                    </Label>
                </HBox>
                <HBox fx:id="structureWorkspaceBody" spacing="8" VBox.vgrow="ALWAYS"
                    styleClass="workspace-body">
                    <VBox fx:id="structureControlRail" minWidth="170.0" prefWidth="220.0" maxWidth="280.0"
                        styleClass="control-rail">
                        <HBox styleClass="rail-header" alignment="CENTER_LEFT">
                            <Label fx:id="structureControlsTitleLabel" styleClass="rail-title" />
                        </HBox>
                        <ScrollPane fx:id="structureControlsScroll" fitToWidth="true"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                            styleClass="panel-scroll-pane">
                            <content>
                                <VBox fillWidth="true" spacing="8" styleClass="module-control-host">
                                    <VBox fx:id="structureNavigationBox" fillWidth="true" spacing="4"
                                        styleClass="workspace-catalog" />
                                    <Separator styleClass="workspace-catalog-divider" />
                                    <VBox fx:id="structureControlsHost" fillWidth="true" spacing="0">
                                        <HBox fx:id="customControlBox" maxWidth="Infinity" fillHeight="true" />
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>
                    <StackPane fx:id="structurePreviewViewport" minWidth="150.0"
                        HBox.hgrow="ALWAYS" styleClass="structure-preview-viewport">
                        <VBox fx:id="structurePreviewEmpty" alignment="CENTER" spacing="10"
                            mouseTransparent="true" styleClass="structure-preview-empty">
                            <Label text="◇" styleClass="structure-preview-glyph" />
                            <Label fx:id="structurePreviewTitleLabel" styleClass="structure-preview-title" />
                            <Label fx:id="structurePreviewHintLabel" wrapText="true"
                                maxWidth="320.0" styleClass="structure-preview-hint" />
                        </VBox>
                    </StackPane>
                    <VBox fx:id="snapshotPanel" minWidth="140.0" prefWidth="180.0" maxWidth="220.0"
                        spacing="7" styleClass="snapshot-panel">
                        <HBox styleClass="rail-header" alignment="CENTER_LEFT" spacing="6">
                            <Label fx:id="snapshotTitleLabel" styleClass="rail-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="snapshotCountLabel" styleClass="panel-kicker" />
                        </HBox>
                        <Button fx:id="saveSnapshotBtn" onAction="#saveStructureSnapshot"
                            maxWidth="Infinity" styleClass="snapshot-save-button" />
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            prefHeight="210.0" VBox.vgrow="ALWAYS" styleClass="snapshot-scroll-pane">
                            <content>
                                <VBox fx:id="snapshotCards" fillWidth="true" spacing="7" />
                            </content>
                        </ScrollPane>
                        <Separator styleClass="workspace-catalog-divider" />
                        <HBox styleClass="rail-header" alignment="CENTER_LEFT" spacing="6">
                            <Label fx:id="structureHistoryTitleLabel" styleClass="rail-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="structureHistoryCountLabel" styleClass="panel-kicker" />
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            prefHeight="160.0" VBox.vgrow="ALWAYS" styleClass="snapshot-scroll-pane">
                            <content>
                                <VBox fx:id="structureHistoryCards" fillWidth="true" spacing="6" />
                            </content>
                        </ScrollPane>
                    </VBox>
                </HBox>
            </VBox>

            <VBox fx:id="algorithmWorkspacePane" focusTraversable="true" managed="false" visible="false">
                <styleClass>
                    <String fx:value="workspace-pane" />
                    <String fx:value="workspace-pane-algorithm" />
                </styleClass>
                <HBox styleClass="workspace-pane-header" alignment="CENTER_LEFT" spacing="8">
                    <VBox spacing="2">
                        <Label fx:id="algorithmWorkspaceTitleLabel" styleClass="workspace-title" />
                        <Label fx:id="algorithmWorkspaceSubtitleLabel" styleClass="workspace-subtitle" />
                        <Label fx:id="algorithmInputSourceLabel" styleClass="algorithm-input-source" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="02">
                        <styleClass>
                            <String fx:value="workspace-index" />
                            <String fx:value="workspace-index-yellow" />
                        </styleClass>
                    </Label>
                </HBox>
                <HBox fx:id="algorithmWorkspaceBody" spacing="8" VBox.vgrow="ALWAYS"
                    styleClass="workspace-body">
                    <VBox fx:id="algorithmControlRail" minWidth="170.0" prefWidth="220.0" maxWidth="280.0"
                        styleClass="control-rail">
                        <HBox styleClass="rail-header" alignment="CENTER_LEFT">
                            <Label fx:id="algorithmControlsTitleLabel" styleClass="rail-title" />
                        </HBox>
                        <ScrollPane fx:id="algorithmControlsScroll" fitToWidth="true"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                            styleClass="panel-scroll-pane">
                            <content>
                                <VBox fillWidth="true" spacing="8" styleClass="module-control-host">
                                    <VBox fx:id="algorithmNavigationBox" fillWidth="true" spacing="8"
                                        styleClass="workspace-catalog" />
                                    <Separator styleClass="workspace-catalog-divider" />
                                    <VBox fx:id="algorithmControlsHost" fillWidth="true" spacing="0" />
                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>
                    <StackPane fx:id="visualizationViewport" minWidth="180.0" minHeight="160.0"
                        HBox.hgrow="ALWAYS" styleClass="visualization-viewport">
                        <StackPane fx:id="visualizationContainer" styleClass="visualization-container" />
                        <VBox alignment="TOP_LEFT" mouseTransparent="true" styleClass="viewport-overlay">
                            <Label fx:id="algorithmViewTitleLabel" styleClass="viewport-title" />
                            <Label fx:id="viewportHintLabel" styleClass="viewport-hint-label" />
                        </VBox>
                    </StackPane>
                    <VBox fx:id="diagnosticsPanel" minWidth="180.0" prefWidth="235.0" maxWidth="300.0"
                        spacing="7" styleClass="diagnostics-panel">
                        <HBox styleClass="rail-header" alignment="CENTER_LEFT" spacing="7">
                            <Label fx:id="statsTitleLabel" styleClass="rail-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="liveLabel">
                                <styleClass>
                                    <String fx:value="panel-kicker" />
                                    <String fx:value="panel-kicker-blue" />
                                </styleClass>
                            </Label>
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            prefHeight="150.0" minHeight="96.0">
                            <styleClass>
                                <String fx:value="stats-scroll-pane" />
                                <String fx:value="stats-card" />
                            </styleClass>
                            <content>
                                <Label fx:id="statsLabel" wrapText="true" maxWidth="Infinity"
                                    styleClass="stats-text" />
                            </content>
                        </ScrollPane>
                        <HBox alignment="CENTER_LEFT">
                            <styleClass>
                                <String fx:value="rail-header" />
                                <String fx:value="rail-header-secondary" />
                            </styleClass>
                            <Label fx:id="logTitleLabel" styleClass="rail-title" />
                        </HBox>
                        <LogView fx:id="logView" VBox.vgrow="ALWAYS">
                            <styleClass>
                                <String fx:value="log-view" />
                                <String fx:value="log-card" />
                            </styleClass>
                        </LogView>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <VBox fx:id="bottomDock" spacing="8" styleClass="bottom-dock">
            <HBox fx:id="playbackToolbar" alignment="CENTER_LEFT" spacing="7" styleClass="playback-toolbar">
                <Button fx:id="startBtn" styleClass="btn-primary" />
                <Button fx:id="pauseBtn" styleClass="btn-ran-white" />
                <Button fx:id="resetBtn" styleClass="btn-ran-red" />
                <Button fx:id="replayBtn" styleClass="btn-ran-blue" />
                <Button fx:id="stepBackwardBtn" text="←">
                    <styleClass>
                        <String fx:value="btn-ran-white" />
                        <String fx:value="step-button" />
                    </styleClass>
                </Button>
                <Button fx:id="stepForwardBtn" text="→">
                    <styleClass>
                        <String fx:value="btn-ran-white" />
                        <String fx:value="step-button" />
                    </styleClass>
                </Button>
                <Separator orientation="VERTICAL" styleClass="toolbar-divider" />
                <Button fx:id="exportBtn" styleClass="btn-ran-yellow" />
                <Button fx:id="compareBtn" styleClass="btn-ran-red" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="delayLabel" styleClass="control-label" />
                <Slider fx:id="delaySlider" min="0" max="500" value="50" blockIncrement="10"
                    minWidth="120.0" prefWidth="180.0" maxWidth="220.0" />
            </HBox>
            <HBox fx:id="timelineRow" alignment="CENTER_LEFT" spacing="12" styleClass="timeline-row">
                <Label fx:id="timelineLabel" minWidth="68.0" styleClass="control-label" />
                <Slider fx:id="timelineSlider" min="0" max="1" value="0" disable="true"
                    minWidth="140.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
