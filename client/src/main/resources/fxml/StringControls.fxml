<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
    alignment="TOP_LEFT" spacing="0" fillWidth="true" minWidth="0.0" prefWidth="240.0" maxWidth="Infinity"
    styleClass="module-control-panel" stylesheets="@../style/theme.css">
    <VBox spacing="7">
        <styleClass><String fx:value="control-section"/><String fx:value="control-card"/><String fx:value="structure-section"/></styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true" onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="structureLabel" styleClass="control-label"/><Region HBox.hgrow="ALWAYS"/><Label text="⌃" styleClass="section-chevron"/>
        </HBox>
        <ComboBox fx:id="structureSelector" maxWidth="Infinity"/>
    </VBox>
    <VBox spacing="7">
        <styleClass><String fx:value="control-section"/><String fx:value="control-card"/><String fx:value="algorithm-section"/></styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true" onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="algorithmLabel" styleClass="control-label"/><Region HBox.hgrow="ALWAYS"/><Label text="⌃" styleClass="section-chevron"/>
        </HBox>
        <ComboBox fx:id="algorithmSelector" maxWidth="Infinity"/>
    </VBox>
    <VBox spacing="8">
        <styleClass><String fx:value="control-section"/><String fx:value="control-card"/><String fx:value="operation-section"/><String fx:value="structure-section"/></styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true" onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="editSectionLabel" styleClass="control-label"/><Region HBox.hgrow="ALWAYS"/><Label text="⌃" styleClass="section-chevron"/>
        </HBox>
        <TextField fx:id="valueField" maxWidth="Infinity" styleClass="dark-textfield"/>
        <HBox spacing="6"><Button fx:id="replaceBtn" onAction="#handleReplace" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-ran-blue"/><Button fx:id="insertBtn" onAction="#handleInsert" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-ran-gold"/></HBox>
        <HBox spacing="6"><TextField fx:id="indexField" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="dark-textfield"/><TextField fx:id="lengthField" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="dark-textfield"/></HBox>
        <HBox spacing="6"><TextField fx:id="characterField" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="dark-textfield"/><Button fx:id="updateBtn" onAction="#handleUpdate" styleClass="btn-ran-gold"/><Button fx:id="removeBtn" onAction="#handleRemove" styleClass="btn-ran-red"/></HBox>
    </VBox>
    <VBox spacing="8">
        <styleClass><String fx:value="control-section"/><String fx:value="control-card"/><String fx:value="execution-section"/><String fx:value="algorithm-section"/></styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true" onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="searchSectionLabel" styleClass="control-label"/><Region HBox.hgrow="ALWAYS"/><Label text="⌃" styleClass="section-chevron"/>
        </HBox>
        <TextField fx:id="patternField" maxWidth="Infinity" styleClass="dark-textfield"/>
        <Button fx:id="runBtn" onAction="#handleAlgorithmStart" visible="false" managed="false" maxWidth="Infinity" styleClass="btn-run-neon"/>
    </VBox>
</VBox>
