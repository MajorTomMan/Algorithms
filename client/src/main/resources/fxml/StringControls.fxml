<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
    alignment="TOP_LEFT" spacing="0" fillWidth="true" minWidth="0.0" prefWidth="240.0"
    maxWidth="Infinity"
    styleClass="module-control-panel" stylesheets="@../style/theme.css">
    <VBox spacing="7">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="structure-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="structureLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <ComboBox fx:id="structureSelector" maxWidth="Infinity" />
    </VBox>
    <VBox spacing="7">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="algorithm-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="algorithmLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <ComboBox fx:id="algorithmSelector" maxWidth="Infinity" />
    </VBox>
    <VBox spacing="8">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="operation-section" />
            <String fx:value="structure-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="editSectionLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <TextField fx:id="valueField" maxWidth="Infinity">
            <styleClass>
                <String fx:value="dark-textfield" />
                <String fx:value="operation-input" />
            </styleClass>
        </TextField>
        <HBox spacing="6" styleClass="operation-row">
            <Button fx:id="replaceBtn" onAction="#handleReplace" maxWidth="Infinity"
                HBox.hgrow="ALWAYS">
                <styleClass>
                    <String fx:value="btn-ran-blue" />
                    <String fx:value="operation-button" />
                </styleClass>
            </Button>
            <Button fx:id="insertBtn" onAction="#handleInsert" maxWidth="Infinity"
                HBox.hgrow="ALWAYS">
                <styleClass>
                    <String fx:value="btn-ran-gold" />
                    <String fx:value="operation-button" />
                </styleClass>
            </Button>
        </HBox>
        <HBox spacing="6" styleClass="operation-row">
            <TextField fx:id="indexField" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <styleClass>
                    <String fx:value="dark-textfield" />
                    <String fx:value="operation-input" />
                </styleClass>
            </TextField>
            <TextField fx:id="lengthField" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <styleClass>
                    <String fx:value="dark-textfield" />
                    <String fx:value="operation-input" />
                </styleClass>
            </TextField>
        </HBox>
        <TextField fx:id="characterField" maxWidth="Infinity">
            <styleClass>
                <String fx:value="dark-textfield" />
                <String fx:value="operation-input" />
            </styleClass>
        </TextField>
        <HBox spacing="6" styleClass="operation-row">
            <Button fx:id="updateBtn" onAction="#handleUpdate" maxWidth="Infinity"
                HBox.hgrow="ALWAYS">
                <styleClass>
                    <String fx:value="btn-ran-gold" />
                    <String fx:value="operation-button" />
                </styleClass>
            </Button>
            <Button fx:id="removeBtn" onAction="#handleRemove" maxWidth="Infinity"
                HBox.hgrow="ALWAYS">
                <styleClass>
                    <String fx:value="btn-ran-red" />
                    <String fx:value="operation-button" />
                </styleClass>
            </Button>
        </HBox>
    </VBox>
    <VBox spacing="8">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="execution-section" />
            <String fx:value="algorithm-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="searchSectionLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <TextField fx:id="patternField" maxWidth="Infinity">
            <styleClass>
                <String fx:value="dark-textfield" />
                <String fx:value="operation-input" />
            </styleClass>
        </TextField>
        <Button fx:id="runBtn" onAction="#handleAlgorithmStart" maxWidth="Infinity" visible="false"
            managed="false" styleClass="btn-run-neon" />
    </VBox>
</VBox>