<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
    alignment="TOP_LEFT" spacing="0" fillWidth="true" minWidth="0.0" prefWidth="240.0" maxWidth="Infinity"
    styleClass="module-control-panel" stylesheets="@../style/theme.css">
    <VBox spacing="7">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="structureTitleLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <ComboBox fx:id="structureSelector" maxWidth="Infinity" styleClass="dark-combo-box" />
    </VBox>

    <VBox spacing="7">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="generatorTitleLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <ComboBox fx:id="generatorSelector" maxWidth="Infinity" styleClass="dark-combo-box" />
    </VBox>

    <VBox spacing="7">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="pathfinderTitleLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <ComboBox fx:id="pathfinderSelector" maxWidth="Infinity" styleClass="dark-combo-box" />
    </VBox>

    <VBox spacing="8">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="operation-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="sizeSectionLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <HBox styleClass="operation-caption-row" alignment="CENTER_LEFT">
            <Label fx:id="sizeLabel" styleClass="operation-label" />
            <Label fx:id="sizeValueLabel" styleClass="operation-value" />
        </HBox>
        <Slider fx:id="sizeSlider" min="11" max="99" value="51" blockIncrement="2"
            majorTickUnit="22" showTickLabels="true" showTickMarks="true" maxWidth="Infinity"
            styleClass="operation-slider" />
        <Button fx:id="applySizeBtn" onAction="#handleApplySize" maxWidth="Infinity">
            <styleClass>
                <String fx:value="btn-ran-gold" />
                <String fx:value="operation-button" />
            </styleClass>
        </Button>
    </VBox>

    <VBox spacing="8">
        <styleClass>
            <String fx:value="control-section" />
            <String fx:value="control-card" />
            <String fx:value="operation-section" />
        </styleClass>
        <HBox styleClass="control-section-header" alignment="CENTER_LEFT" focusTraversable="true"
            onMouseClicked="#toggleSection" onKeyPressed="#handleSectionKey">
            <Label fx:id="operationsSectionLabel" styleClass="control-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="⌃" styleClass="section-chevron" />
        </HBox>
        <Label fx:id="operationHintLabel" styleClass="operation-hint" wrapText="true" />
        <HBox spacing="6" styleClass="operation-row">
            <Button fx:id="buildBtn" onAction="#handleGenerate" maxWidth="Infinity">
                <styleClass>
                    <String fx:value="btn-ran-blue" />
                    <String fx:value="operation-button" />
                </styleClass>
            </Button>
            <Button fx:id="solveBtn" onAction="#handleSolve" maxWidth="Infinity">
                <styleClass>
                    <String fx:value="btn-ran-red" />
                    <String fx:value="operation-button" />
                </styleClass>
            </Button>
        </HBox>
        <Button fx:id="resetMazeBtn" onAction="#handleResetMaze" maxWidth="Infinity">
            <styleClass>
                <String fx:value="btn-ran-white" />
                <String fx:value="operation-button" />
            </styleClass>
        </Button>
    </VBox>
</VBox>
