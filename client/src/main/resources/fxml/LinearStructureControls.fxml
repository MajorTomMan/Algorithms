<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="10" styleClass="control-section">
    <Label fx:id="typeLabel" styleClass="section-title" />
    <Label fx:id="operationsLabel" styleClass="control-label" />
    <TextField fx:id="valueField" />
    <TextField fx:id="indexField" />
    <HBox spacing="6">
        <Button fx:id="primaryBtn" onAction="#handlePrimary" />
        <Button fx:id="secondaryBtn" onAction="#handleSecondary" />
    </HBox>
    <HBox spacing="6">
        <Button fx:id="tertiaryBtn" onAction="#handleTertiary" />
        <Button fx:id="quaternaryBtn" onAction="#handleQuaternary" />
    </HBox>
</VBox>
