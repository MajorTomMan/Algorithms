+/* Central Workbench shell layout. Loaded last so shell policy wins over legacy per-tier fixes. */
+
+/* Header widths/heights are owned by WorkbenchUiFramework, not fixed CSS tiers. */
+.root-pane .lab-top-bar {
+    -fx-min-height: -1;
+    -fx-pref-height: -1;
+    -fx-max-height: -1;
+}
+.root-pane .brand-zone,
+.root-pane .lab-mode-switch,
+.root-pane .top-context-zone,
+.root-pane .family-rail,
+.root-pane .structure-control-panel,
+.root-pane .algorithm-control-panel,
+.root-pane .inspector-panel {
+    -fx-min-width: -1;
+    -fx-pref-width: -1;
+    -fx-max-width: Infinity;
+}
+
+/* Inspector tabs remain readable; the framework computes tab widths from actual localized text. */
+.root-pane .inspector-tabs {
+    -fx-tab-min-height: 2.8em;
+}
+.root-pane .inspector-tabs .tab {
+    -fx-padding: 0 0.9em;
+}
+
+/* Execution toolbar: semantic groups, font-aware controls, flexible timeline. */
+.root-pane .timeline-compact-row,
+.root-pane.font-size-large .timeline-compact-row,
+.root-pane.font-size-xlarge .timeline-compact-row,
+.root-pane:compact-layout .timeline-compact-row,
+.root-pane:narrow-layout .timeline-compact-row,
+.root-pane.font-size-large:compact-layout .timeline-compact-row,
+.root-pane.font-size-xlarge:compact-layout .timeline-compact-row,
+.root-pane.font-size-large:narrow-layout .timeline-compact-row,
+.root-pane.font-size-xlarge:narrow-layout .timeline-compact-row {
+    -fx-padding: 9px 18px;
+    -fx-min-height: -1;
+    -fx-pref-height: -1;
+    -fx-max-height: Infinity;
+}
+
+.root-pane .timeline-compact-row .playback-button,
+.root-pane .timeline-compact-row .playback-primary,
+.root-pane.font-size-large .timeline-compact-row .playback-button,
+.root-pane.font-size-xlarge .timeline-compact-row .playback-button,
+.root-pane.font-size-large .timeline-compact-row .playback-primary,
+.root-pane.font-size-xlarge .timeline-compact-row .playback-primary,
+.root-pane:compact-layout .timeline-compact-row .playback-button,
+.root-pane:narrow-layout .timeline-compact-row .playback-button,
+.root-pane:compact-layout .timeline-compact-row .playback-primary,
+.root-pane:narrow-layout .timeline-compact-row .playback-primary {
