+    -fx-max-width: Infinity;
+    -fx-min-height: 2.65em;
+    -fx-pref-height: 2.65em;
+    -fx-max-height: 2.65em;
+    -fx-padding: 0 1.0em;
+}
+
+.root-pane .timeline-compact-row .playback-icon-button,
+.root-pane.font-size-large .timeline-compact-row .playback-icon-button,
+.root-pane.font-size-xlarge .timeline-compact-row .playback-icon-button,
+.root-pane:compact-layout .timeline-compact-row .playback-icon-button,
+.root-pane:narrow-layout .timeline-compact-row .playback-icon-button {
