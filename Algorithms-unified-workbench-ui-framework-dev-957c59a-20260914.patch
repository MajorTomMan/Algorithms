+    -fx-min-height: 2.65em;
+    -fx-pref-height: 2.65em;
+    -fx-max-height: 2.65em;
+    -fx-padding: 0;
+}
+
+/* Timeline disclosure belongs to the timeline header, not the speed group. */
+.root-pane .timeline-header-bar {
+    -fx-padding: 6px 18px 7px 18px;
+    -fx-min-height: -1;
+    -fx-pref-height: -1;
+    -fx-background-color: -ui-white;
+    -fx-border-color: -ui-gray-200 transparent transparent transparent;
+    -fx-border-width: 1px 0 0 0;
+}
+.root-pane .timeline-header-bar .timeline-legend {
+    -fx-padding: 0;
+}
+.root-pane .timeline-header-toggle {
+    -fx-min-width: 2.4em;
+    -fx-pref-width: 2.4em;
+    -fx-max-width: 2.4em;
+    -fx-min-height: 2.2em;
+    -fx-pref-height: 2.2em;
+    -fx-max-height: 2.2em;
+}
+
+/* Form framework owns all non-canvas data-entry geometry. */
+.root-pane .control-section,
+.root-pane .control-card,
+.root-pane .operation-section,
+.root-pane .execution-section {
+    -fx-min-width: 0;
+    -fx-max-width: Infinity;
+}
