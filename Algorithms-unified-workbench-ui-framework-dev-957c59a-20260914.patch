+    -fx-border-color: -ui-red;
+    -fx-text-fill: -ui-white;
+}
+.root-pane .timeline-compact-row .playback-end-button {
+    -fx-background-color: -ui-white;
+    -fx-border-color: -ui-gray-300;
+    -fx-text-fill: -ui-black;
+}
+.root-pane .timeline-compact-row .playback-close-button {
